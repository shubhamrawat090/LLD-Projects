      "seed": 1903719516,
      "version": 545,
      "versionNonce": 345721316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793538134040,
      "created": 1793537854236,
      "link": null,
      "locked": false,
      "text": "Check: A king is under the threat of capture\nCheckmate: A king is in check and cannot excape - GAME OVER\nStalemate: A player has no legal moves, AND the king is NOT IN CHECK - results in DRAW\n\nDraw: The game also ends in a draw via:\n    - Threefold repetition\n    - Fifty-move rule\n    - Insufficient Material\n    - Mutual agreement",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Check: A king is under the threat of capture\nCheckmate: A king is in check and cannot excape - GAME OVER\nStalemate: A player has no legal moves, AND the king is NOT IN CHECK - results in DRAW\n\nDraw: The game also ends in a draw via:\n    - Threefold repetition\n    - Fifty-move rule\n    - Insufficient Material\n    - Mutual agreement",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
