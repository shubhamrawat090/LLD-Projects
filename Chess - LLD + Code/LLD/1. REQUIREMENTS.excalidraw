      "seed": 2119784820,
      "version": 63,
      "versionNonce": 136973276,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793536027924,
      "link": null,
      "locked": false,
      "text": "Handles Observer Pattern for live game\nupdates.\n\nListeners/Spectators subscribe to\npublisher.\n\nWhenever move/game-state events occur:\n    -> publisher notifies all listeners\n\nUsed for:\n    - spectating games\n    - UI updates\n    - live notifications\n    - websocket broadcasting later",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Handles Observer Pattern for live game updates.\n\nListeners/Spectators subscribe to publisher.\n\nWhenever move/game-state events occur:\n    -> publisher notifies all listeners\n\nUsed for:\n    - spectating games\n    - UI updates\n    - live notifications\n    - websocket broadcasting later",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
