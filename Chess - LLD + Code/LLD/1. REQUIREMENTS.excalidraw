      "created": 1793536493299,
      "link": null,
      "locked": false,
      "text": "- King: 1 square in any direction\n- Queen: Any no. of squares in any direction\n- Bishop: Any no. of squares diagonally\n- Rook: Any no. of squares horizontally/vertically\n- Knight: Moves in L-shape - 2 steps ahead + 1 step perpendicular\n- Pawn: Moves 1 step forward + Captures 1 step diagonally\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- King: 1 square in any direction\n- Queen: Any no. of squares in any direction\n- Bishop: Any no. of squares diagonally\n- Rook: Any no. of squares horizontally/vertically\n- Knight: Moves in L-shape - 2 steps ahead + 1 step perpendicular\n- Pawn: Moves 1 step forward + Captures 1 step diagonally\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
