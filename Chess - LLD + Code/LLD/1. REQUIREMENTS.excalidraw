    {
      "id": "Mh7_r61MTcVNIHEjN8NfC",
      "type": "text",
      "x": -749.6017591663273,
      "y": -249.85057078654245,
      "width": 1238.5714285714284,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
