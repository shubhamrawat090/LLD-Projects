    {
      "id": "PVPkvYCGWBPvS2C7X3O3k",
      "type": "text",
      "x": -470.9625582658538,
      "y": -234.92994039223697,
      "width": 339.2228054470486,
      "height": 280,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
